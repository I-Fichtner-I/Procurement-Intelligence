# Kopiere diese Datei nach .env und trage deine Werte ein.
# .env wird NICHT eingecheckt (siehe .gitignore). Niemals Secrets im Quellcode ablegen.

# --- Datenbank -------------------------------------------------------------
# SQLite (lokale Entwicklung, Default) oder PostgreSQL (Produktion)
TENDER_AI_DATABASE_URL=sqlite:///./data/tender_ai.db
# TENDER_AI_DATABASE_URL=postgresql+psycopg://user:passwort@localhost:5432/tender_ai

# --- Pfade -----------------------------------------------------------------
TENDER_AI_CONFIG_FILE=./config.yaml
TENDER_AI_DATA_DIR=./data

# --- HTTP ------------------------------------------------------------------
# Kontaktadresse im User-Agent: faire Praxis gegenueber Portalbetreibern.
TENDER_AI_HTTP__USER_AGENT=tender-ai/0.1 (+mailto:kontakt@example.org)

# --- Quellen: API-Schluessel ----------------------------------------------
# Ein Schluessel je Quelle; <NAME> ist der Quellname aus config.yaml
# (sources.<name>). Beispiel fuer die Quelle "ted":
TENDER_AI_SOURCE_API_KEYS__TED=
# Weitere Quellen nach demselben Muster, z. B. TENDER_AI_SOURCE_API_KEYS__DTVP=
#
# Abwaertskompatibel bleibt fuer TED auch:
# TENDER_AI_TED_API_KEY=

# --- Benachrichtigungen (Stufe 2+) -----------------------------------------
TENDER_AI_SMTP_HOST=
TENDER_AI_SMTP_USER=
TENDER_AI_SMTP_PASSWORD=
TENDER_AI_TELEGRAM_BOT_TOKEN=
TENDER_AI_TELEGRAM_CHAT_ID=
TENDER_AI_SLACK_WEBHOOK_URL=

# --- KI (Stufe 2+: Dokumentenanalyse, Produkt-Matching) --------------------
ANTHROPIC_API_KEY=

# --- Benachrichtigungen (Stufe 8) --------------------------------------------
# Zugangsdaten des Mailversands; Host, Port und Empfaenger stehen in config.yaml.
# TENDER_AI_SMTP_USER=tender-ai@example.org
# TENDER_AI_SMTP_PASSWORD=
# Wird als "Authorization: Bearer <token>" an den Webhook geschickt.
# TENDER_AI_WEBHOOK_TOKEN=

# --- Weboberflaeche (Stufe 9) ------------------------------------------------
# Pflicht, sobald web.host nicht 127.0.0.1 ist.
# TENDER_AI_WEB_TOKEN=
